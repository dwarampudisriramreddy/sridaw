FROM ubuntu:22.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-setuptools \
    openjdk-17-jdk \
    git \
    zip \
    unzip \
    autoconf \
    libtool \
    pkg-config \
    zlib1g-dev \
    libncurses5-dev \
    libncursesw5-dev \
    libtinfo5 \
    cmake \
    libffi-dev \
    libssl-dev \
    build-essential \
    libsqlite3-dev \
    libgdbm-dev \
    libreadline-dev \
    libbz2-dev \
    liblzma-dev \
    tk-dev \
    libdb-dev \
    && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Install buildozer
RUN pip3 install buildozer

# Create working directory
WORKDIR /app

# Copy project files
COPY . .

# Build APK
CMD ["sh", "-c", "yes | buildozer android debug"]